# 复制这个文件为 .env，然后填上你自己的密钥。
# .env 不要提交到 GitHub（.gitignore 里已经排除）。

# ---------- 大模型（任何 OpenAI 兼容服务商都可以）----------
# 智谱      https://open.bigmodel.cn/api/paas/v4    glm-4-flash
# 硅基流动  https://api.siliconflow.cn/v1           Qwen/Qwen2.5-7B-Instruct
# DeepSeek  https://api.deepseek.com/v1             deepseek-chat
LLM_API_KEY=在这里填你的密钥
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.3

# ---------- 向量化 ----------
# 留空则复用上面大模型的 key 和 base_url；用别的服务商就单独填
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=embedding-3
EMBEDDING_BATCH=16

# ---------- 检索参数（调这些会直接影响效果，值得反复试）----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
HYBRID_ALPHA=0.6
SCORE_THRESHOLD=0.30

# ---------- 会话 ----------
MAX_TURNS=8
SESSION_TTL=3600
# 装了 Redis 就填，例如 redis://localhost:6379/0；留空则用内存
REDIS_URL=

# ---------- Agent ----------
MAX_AGENT_ROUNDS=5
